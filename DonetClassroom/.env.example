# ---------------------------------------------------------------------------
# DonetClassroom environment configuration
# Copy this file to `.env` and fill in what you need. `.env` is git-ignored.
# Everything here is optional — the app runs with local Ollama and no key.
# ---------------------------------------------------------------------------

# Server
PORT=5173
HOST=127.0.0.1

# --- Local AI (Ollama) ------------------------------------------------------
# Where your Ollama daemon is listening.
OLLAMA_URL=http://localhost:11434

# --- Free cloud AI (Google Gemini) -----------------------------------------
# Create a key at https://aistudio.google.com/apikey  (free tier works fine).
# When set, Auto mode falls back to Gemini before OpenRouter. NEVER commit a real key.
GEMINI_API_KEY=

# --- Free cloud AI (OpenRouter) --------------------------------------------
# Create a key at https://openrouter.ai/keys  (free tier works fine).
# Leave blank to run local-only. NEVER commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1

# Optional attribution headers sent to OpenRouter (they are shown on their
# dashboards / leaderboards). Safe to leave as-is.
APP_URL=http://localhost:5173
APP_TITLE=DonetClassroom

# --- Zero-cost protection ---------------------------------------------------
# When true (default) the server refuses to call any model that currently has
# non-zero pricing. Set to false ONLY if you knowingly want paid models.
FREE_ONLY=true

# Request timeout in milliseconds for non-streaming provider calls.
REQUEST_TIMEOUT_MS=120000
